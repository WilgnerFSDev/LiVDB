# NVD API Token for faster CVE fetching
# Get one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Local Path to the Source Code Repository Clone
SOURCE_CODE_PATH=
DEFAULT_CPE=cpe:2.3:o:linux:linux_kernel

# Granular CPE attributes (defaults to '*' for search)
CPE_VERSION=*
CPE_UPDATE=*
CPE_EDITION=*
CPE_LANGUAGE=*
CPE_SW_EDITION=*
CPE_TARGET_SW=*
CPE_TARGET_HW=*
CPE_OTHER=*

# Output directory for preprocessed plugin datasets
PREPROC_DATASETS_DIR=preproc_datasets

# Optional explicit path to Joern binary (used by plugin_cfvd if not in PATH)
JOERN_BIN=
